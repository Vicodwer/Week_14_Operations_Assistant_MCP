# Operations Assistant — Environment Template
# Copy this file to .env and adjust if needed.
# Never commit .env — it is gitignored.

# ── Ollama (local, free model) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2:3b

# ── Crew behaviour ─────────────────────────────────────────────────────────
VERBOSE_MODE=true

# ── No paid API keys required ──────────────────────────────────────────────
# This project runs entirely on a local Ollama model.
# Do not add OPENAI_API_KEY or ANTHROPIC_API_KEY here.